# Copy this file to .env and fill in real values, then run `direnv allow`.
# .env is gitignored and loaded automatically via `.envrc` (dotenv_if_exists .env)
# so real hosts/tokens never get committed.

# --- XMRig miner(s) ---
MINER_HOST=192.168.1.100
MINER_PORT=9999

# --- XMRig proxy ---
PROXY_HOST=192.168.1.101
PROXY_PORT=9999

# --- MoneroOcean pool ---
XMR_ADDRESS=your_monero_address_here

# --- Wemo Insight power plug ---
POWER_HOST=192.168.1.102

# --- Monero wallet RPC ---
WALLET_HOST=192.168.1.103
WALLET_PORT=18083

# --- CoinMarketCap ---
CMC_API_KEY=your_cmc_api_key_here

# --- InfluxDB 2.x ---
INFLUX_HOST=192.168.1.10:8086
INFLUX_ORG=your_org_name
INFLUX_ORG_ID=your_org_id
INFLUX_BUCKET=MoneroMetrics
INFLUX_TOKEN=your_influx_token_here
